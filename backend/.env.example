APP_NAME=Dock Appointment Scheduling
APP_VERSION=0.1.0
DEBUG=False
DATABASE_URL=postgresql://user:password@localhost:5432/dock_appointments
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com
JWT_ISSUER=dock-appointment-scheduling
JWT_AUDIENCE=dock-appointment-api
SERVICE_AUTH_TOKEN_EXPIRE_SECONDS=300
SERVICE_AUTH_ISSUER=dock-appointment-scheduling
SERVICE_AUTH_AUDIENCE=dockflow-operations
# Generate a random secret and use the same value in DockFlow Operations.
# SERVICE_AUTH_SECRET=
# YMS_SERVICE_AUTH_SECRET must be a separate random secret shared only with YMS.
# YMS_SERVICE_AUTH_SECRET=
YMS_SERVICE_AUTH_ISSUER=dockflow-yms
YMS_SERVICE_AUTH_AUDIENCE=dock-appointment-scheduling
